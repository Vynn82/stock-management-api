# Database Configuration (In Docker, DB_HOST should be 'postgres' or your RDS endpoint)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=Vynn82
DB_PASSWORD=your_strong_db_password
DB_DATABASE=stock-management-db

# Super Admin Account
SUPER_ADMIN_FIRST_NAME=Vin82
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=your_admin_password

# Authentication
JWT_ACCESS_SECRET=your_jwt_secret_key_here

# Cloudinary Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mailer (SMTP)
